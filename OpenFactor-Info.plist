<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Only the keys Xcode cannot generate. GENERATE_INFOPLIST_FILE stays on and merges the
	  rest in, so the usage strings and scene manifest still live in build settings where
	  they were. Arrays of dictionaries have no INFOPLIST_KEY form, which is the whole
	  reason this file exists.
	-->

	<!--
	  **There is deliberately no CFBundleURLTypes here.**

	  An earlier version declared an `openfactor` scheme so the share extension could hand the
	  app an item by name. A share extension turned out not to be permitted to open its
	  containing app at all, measured twice, so nothing can produce that URL any more.

	  Declaring a scheme means every app on the device can send this one a URL. Keeping one
	  that nothing produces would be surface with no purpose, so it is gone. Files still open
	  through the document types below, which is a different mechanism.
	-->

	<!--
	  This project's own backup, declared so it has a name and an icon in Files and Mail
	  rather than being an unknown blob. Exported rather than imported, because this project
	  defines the format: docs/BACKUP_FORMAT.md is its specification.
	-->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>dev.openfactor.backup</string>
			<key>UTTypeDescription</key>
			<string>OpenFactor backup</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>openfactor</string>
				</array>
			</dict>
		</dict>
	</array>

	<!--
	  What "Open in OpenFactor" offers, from Files or a mail attachment, so a backup does not
	  have to be routed through the in-app picker.

	  **Aegis is declared as JSON rather than as its own type.** Aegis does not publish a
	  uniform type identifier, and inventing one here would claim ownership of somebody
	  else's format. The importer already sniffs the contents and refuses what it does not
	  recognize, so the plist being broad costs nothing: a JSON file that is not an Aegis
	  vault is turned away by the parser, not by this list.
	-->
	<!--
	  **A copy, not the original.** Apple's upload check flags a CFBundleDocumentTypes
	  declaration that does not answer this, and leaving it unanswered means iOS decides for
	  itself which one OpenFactor gets.

	  NO is right here. The importer reads the bytes and is finished; asking to open in place
	  would be asking for write access to somebody's file for no reason at all, and this app
	  should hold the fewest permissions that do the job.
	-->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>

	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>OpenFactor backup</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>dev.openfactor.backup</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Authenticator export</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.json</string>
				<string>public.plain-text</string>
				<string>public.rtf</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
