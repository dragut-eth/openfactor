# Reference material, not part of the project.
# Anchored with a leading slash so it means the assets/ directory at the repository
# root and nothing else. Unanchored, it also matched site/assets/, which silently
# excluded the website's stylesheet and icon from every commit.
/assets/

# Xcode
build/
DerivedData/
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.resolved

# macOS
.DS_Store

# Secrets, never commit
*.p12
*.mobileprovision
*.cer
