<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  One entitlement, and the absence of the other one is the security property.

	  **There is deliberately no keychain-access-groups here.** The same rule the watch
	  complication follows: the extension cannot read an account and cannot write one, and that
	  is enforced by the system rather than promised in a comment. Anyone auditing this should
	  check that this file still has exactly one key.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.openfactor</string>
	</array>
</dict>
</plist>
