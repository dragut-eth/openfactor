<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.share-services</string>
		<!--
		  Module qualified, which is not optional. A Swift class name is mangled, so a bare
		  "ShareViewController" does not resolve through the ObjC runtime: the extension launches,
		  presents nothing, and never completes its request, which on a phone is a black sheet that
		  cannot be dismissed. The class is also marked @objc for the same reason, twice over.
		-->
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).ShareViewController</string>
		<!--
		  Images only, one at a time, and no text, no URLs, no files of other kinds. A share
		  extension that accepts everything is offered everywhere, which trains people to
		  send it things it cannot use.
		-->
		<key>NSExtensionAttributes</key>
		<dict>
			<key>NSExtensionActivationRule</key>
			<dict>
				<key>NSExtensionActivationSupportsImageWithMaxCount</key>
				<integer>1</integer>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
